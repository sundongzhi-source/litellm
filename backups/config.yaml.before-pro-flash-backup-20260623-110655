router_settings:
  routing_strategy: simple-shuffle
  num_retries: 5
  timeout: 120
  allowed_fails: 3
  cooldown_time: 60

litellm_settings:
  callbacks: [prometheus]
  service_callback: [prometheus_system]
  request_timeout: 120
  use_chat_completions_url_for_anthropic_messages: true
  set_verbose: false

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
